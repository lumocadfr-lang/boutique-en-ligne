// LumoCAD — Schéma de données e-commerce
// Dev : SQLite (zéro dépendance). Prod : passer `provider` à "postgresql"
// et mettre à jour DATABASE_URL (Neon, Supabase, RDS…). Le schéma est volontairement
// portable (pas d'enums natifs ni de tableaux scalaires) pour migrer sans friction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Catalogue
// ──────────────────────────────────────────────────────────────────────────

model Collection {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  subtitle       String?
  description     String?
  heroImage       String?
  position        Int       @default(0)
  seoTitle        String?
  seoDescription  String?
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  tagline          String?           // accroche courte (effet coucher de soleil…)
  excerpt          String?           // résumé pour les cartes / listes
  description      String            // description riche (markdown/HTML léger)
  story            String?           // storytelling « histoire du produit »
  category         String            // SUSPENSION | APPLIQUE | LAMPE_A_POSER | LAMPADAIRE | SUR_MESURE
  status           String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  featured         Boolean   @default(false)

  priceCents       Int                // prix en centimes (TTC)
  compareAtCents   Int?               // prix barré (promo / précommande)
  currency         String    @default("EUR")
  sku              String?
  stock            Int       @default(0)
  leadTimeDays     String?            // « 3 à 12 jours ouvrés »
  madeToOrder      Boolean   @default(true)

  material         String?            // PLA biodégradable, PETG translucide…
  color            String?
  dimensions       String?            // ex. « Ø 28 × H 22 cm »
  weightGrams      Int?
  bulbType         String?            // E27, E14, LED intégrée…

  seoTitle         String?
  seoDescription   String?

  collection       Collection?  @relation(fields: [collectionId], references: [id])
  collectionId     String?

  images           ProductImage[]
  specs            ProductSpec[]
  reviews          Review[]
  orderItems       OrderItem[]
  faqs             ProductFaq[]

  // Cross-selling : produits complémentaires (auto-relation many-to-many)
  relatedTo        Product[]  @relation("RelatedProducts")
  relatedFrom      Product[]  @relation("RelatedProducts")

  shopifyId        String?   @unique  // traçabilité de l'import Shopify

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([category])
  @@index([featured])
}

model ProductImage {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  url        String
  alt        String?
  width      Int?
  height     Int?
  position   Int      @default(0)

  @@index([productId])
}

model ProductSpec {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  label      String   // « Matériau », « Dimensions », « Source lumineuse »…
  value      String
  position   Int      @default(0)

  @@index([productId])
}

model ProductFaq {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  question   String
  answer     String
  position   Int      @default(0)

  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  author     String
  location   String?
  rating     Int      @default(5)
  title      String?
  body       String
  verified   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────
// Commandes
// ──────────────────────────────────────────────────────────────────────────

model Order {
  id                String      @id @default(cuid())
  number            String      @unique          // ex. LUMO-2026-0001
  status            String      @default("PENDING") // PENDING | PAID | FULFILLED | CANCELLED | REFUNDED
  email             String

  subtotalCents     Int
  shippingCents     Int         @default(0)
  totalCents        Int
  currency          String      @default("EUR")

  customerName      String?
  phone             String?
  shippingAddress   String?
  shippingCity      String?
  shippingZip       String?
  shippingCountry   String?     @default("FR")
  note              String?

  stripeSessionId   String?     @unique
  stripePaymentRef  String?

  items             OrderItem[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([email])
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  title       String
  priceCents  Int
  quantity    Int      @default(1)

  @@index([orderId])
}
