# Copier en `.env` et renseigner les valeurs.

# ── Base de données ────────────────────────────────────────────────────────
# Dev local (SQLite) :
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
# Prod (PostgreSQL — Neon, Supabase, Vercel Postgres…) :
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://lumocad.fr"

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"

# ── Import Shopify (one-shot) ──────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN="lumocad.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
